# CloudBox Configuration
# Copy this to .env and customize

# App
APP_NAME=CloudBox
DEBUG=True

# Database (SQLite for dev, PostgreSQL for production)
# DATABASE_URL=sqlite:///./cloudbox.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cloudbox
DATABASE_URL=sqlite:///./cloudbox.db

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-IN-PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Password reset email. Leave SMTP_HOST empty in development to log reset links
# to the server console instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cloudbox.local
SMTP_USE_TLS=True
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:8000

# Storage
STORAGE_PROVIDER=local
STORAGE_ROOT_DIR=./storage_data

# Default quota: 50 GB in bytes
DEFAULT_QUOTA_BYTES=53687091200

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_GENERAL=60/minute

# CORS Origins (comma-separated, restrict in production)
CORS_ORIGINS=["*"]
